{
	"name": "@injaneity/pi-computer-use",
	"version": "0.5.2-workbench.60",
	"description": "Pi extension that lets AI agents observe and control macOS, Windows, and Linux apps.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"computer-use",
		"macos",
		"desktop-automation",
		"accessibility",
		"linux"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/injaneity/pi-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/injaneity/pi-computer-use/issues"
	},
	"homepage": "https://github.com/injaneity/pi-computer-use#readme",
	"engines": {
		"node": ">=20.6.0"
	},
	"files": [
		"extensions",
		"src",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/macos/agent_cursor.swift",
		"native/macos/agent_cursor_motion.swift",
		"native/macos/optional_image_capture.swift",
		"native/macos/outline_walk.swift",
		"native/macos/bridge.swift",
		"native/macos/foreground_gate.swift",
		"native/macos/text_input_source.swift",
		"native/windows/bridge-rs/Cargo.lock",
		"native/windows/bridge-rs/Cargo.toml",
		"native/windows/bridge-rs/src",
		"native/windows/bridge-rs/tests",
		"prebuilt/macos",
		"prebuilt/windows",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE",
		"native/linux/bridge-rs",
		"prebuilt/linux",
		"docs/*.md",
		"native/macos/accessibility_value.swift",
		"native/macos/bounded_read.swift",
		"native/macos/permission_probe.swift",
		"native/macos/text_selection.swift"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "./assets/reference/img.jpg"
	},
	"scripts": {
		"postinstall": "node scripts/setup-helper.mjs --postinstall",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "node scripts/check-tool-schemas.mjs",
		"test:cdp-navigation": "tsx scripts/check-cdp-navigation.mjs && tsx scripts/check-browser-performance.mjs",
		"test:cdp-viewport": "tsx scripts/check-cdp-viewport.mjs && tsx scripts/check-cdp-loopback.mjs",
		"test:invariants": "node scripts/check-invariants.mjs",
		"test:lifecycle": "tsx scripts/check-session-lifecycle.mjs",
		"test:runtime": "tsx scripts/check-runtime-concurrency.mjs",
		"test:permissions": "tsx scripts/check-permission-readiness.mjs",
		"test:presigned-helper": "node scripts/check-presigned-helper-update.mjs",
		"test:action-preflight": "tsx scripts/check-action-preflight.mjs",
		"test:helper-transport": "tsx scripts/check-helper-transport.mjs && tsx scripts/check-linux-helper-transport.mjs",
		"test:bridge-unknown": "tsx scripts/check-cu-bridge-unknown.mjs",
		"test:native-key-preflight": "tsx scripts/check-native-key-preflight.mjs",
		"test:native-focus-gate": "node scripts/check-native-focus-gate.mjs",
		"test:focus-window": "tsx scripts/check-focus-window.mjs",
		"test:output": "tsx scripts/check-bounded-output.mjs",
		"test:commits": "node scripts/check-commit-messages.mjs",
		"test:platform": "tsx scripts/check-platform-windows.mjs",
		"test:windows-scripts": "node scripts/check-windows-build-scripts.mjs",
		"test:package-assets": "node scripts/check-package-assets.mjs",
		"test:local-build-fingerprint": "node scripts/check-local-build-fingerprint.mjs",
		"test:signing": "node scripts/check-local-signing.mjs",
		"test:macos-path": "node scripts/check-macos-helper-path.mjs",
		"test": "npm run typecheck && npm run test:schema && npm run test:output && npm run test:lifecycle && npm run test:runtime && npm run test:cdp-navigation && npm run test:cdp-viewport && npm run test:browser-startup && npm run test:browser-observe && npm run test:cdp-frames && npm run test:cdp-sessions && npm run test:cdp-input && npm run test:permissions && npm run test:presigned-helper && npm run test:local-build-fingerprint && npm run test:action-preflight && npm run test:native-root-pin && npm run test:root-delta-identity && npm run test:native-commit && npm run test:native-action-outcomes && npm run test:helper-transport && npm run test:bridge-unknown && npm run test:native-key-preflight && npm run test:text-input-source && npm run test:native-focus-gate && npm run test:focus-context && npm run test:focus-window && npm run test:focus-optional-capture && npm run test:readiness-without-capture && npm run test:ocr-failure && npm run test:capture-trace && npm run test:scoped-outline && npm run test:invariants && npm run test:platform && npm run test:linux && npm run test:linux-scripts && npm run test:package-assets && npm run test:signing && npm run test:macos-path && npm run test:macos-identity && npm run test:windows-managed-helper && npm run test:macos-helper-socket && npm run test:macos-outline && npm run test:macos-optional-image && npm run test:macos-values && npm run test:macos-bounded-read && npm run test:macos-root-snapshot && npm run test:macos-menu-pairing && npm run test:macos-dialog-pairing && npm run test:macos-permission-probe && npm run test:macos-permission-diagnostics && npm run test:macos-selection",
		"build:native": "node scripts/build-native.mjs",
		"build:windows": "node scripts/build-native.mjs --platform windows",
		"build:linux": "node scripts/build-native.mjs --platform linux",
		"test:linux": "tsx scripts/check-platform-linux.mjs",
		"test:linux-scripts": "node scripts/check-linux-build-scripts.mjs",
		"test:linux-live": "PI_CU_LIVE=1 tsx scripts/check-linux-live.mjs",
		"test:focus-optional-capture": "tsx scripts/check-focus-optional-capture.mjs",
		"test:readiness-without-capture": "tsx scripts/check-readiness-without-capture.mjs",
		"test:capture-trace": "tsx scripts/check-capture-trace.mjs",
		"test:windows-managed-helper": "tsx scripts/check-windows-managed-helper.mjs",
		"test:windows-foreground": "tsx scripts/check-windows-foreground.mjs",
		"test:browser-observe": "tsx scripts/check-browser-observe.mjs",
		"test:cdp-input": "tsx scripts/check-cdp-input.mjs",
		"test:cdp-frames": "tsx scripts/check-cdp-frames.mjs",
		"test:cdp-sessions": "tsx scripts/check-cdp-sessions.mjs && tsx scripts/check-cdp-ancestor-routes.mjs",
		"test:native-action-outcomes": "tsx scripts/check-native-action-outcomes.mjs && tsx scripts/check-search-ocr-escalation.mjs && tsx scripts/check-pixel-observe.mjs",
		"test:scoped-outline": "tsx scripts/check-scoped-outline.mjs",
		"test:text-input-source": "node scripts/check-text-input-source.mjs",
		"test:macos-identity": "tsx scripts/check-macos-helper-identity.mjs && tsx scripts/check-macos-helper-owned-restart.mjs",
		"test:browser-startup": "tsx scripts/check-browser-startup.mjs",
		"test:ocr-failure": "tsx scripts/check-ocr-failure-preserves-pixels.mjs",
		"test:macos-helper-socket": "node scripts/check-macos-helper-socket.mjs",
		"test:macos-outline": "node scripts/check-macos-outline-walk.mjs",
		"test:macos-optional-image": "tsx scripts/check-macos-optional-image.mjs && node scripts/check-native-optional-image.mjs",
		"test:macos-values": "node scripts/check-macos-accessibility-value.mjs && node scripts/check-macos-action-availability.mjs",
		"test:macos-bounded-read": "node scripts/check-macos-bounded-read.mjs",
		"test:macos-root-snapshot": "node scripts/check-macos-root-snapshot.mjs && tsx scripts/check-macos-root-observation.mjs",
		"test:native-root-pin": "tsx scripts/check-native-root-pin.mjs",
		"test:macos-menu-pairing": "node scripts/check-macos-menu-pairing.mjs",
		"test:macos-dialog-pairing": "node scripts/check-macos-dialog-pairing.mjs",
		"test:macos-permission-probe": "node scripts/check-macos-permission-probe.mjs",
		"test:macos-permission-diagnostics": "tsx scripts/check-macos-permission-diagnostics.mjs",
		"test:native-commit": "tsx scripts/check-native-commit.mjs",
		"test:root-delta-identity": "tsx scripts/check-root-delta-identity.mjs",
		"test:macos-selection": "tsx scripts/check-native-text-selection.mjs && node scripts/check-macos-text-selection.mjs",
		"test:focus-context": "tsx scripts/check-focus-context.mjs && node scripts/check-macos-focused-context.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
